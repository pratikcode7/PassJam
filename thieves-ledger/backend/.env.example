# Copy to .env and adjust. Every value is optional.
PORT=3000
DB_PATH=./data/riddle-lock.db

# Any http://localhost:* and http://127.0.0.1:* origin is always allowed.
# Add deployed frontends here (comma separated):
CORS_ORIGINS=
# Allow a frontend opened straight from disk (file:// sends "Origin: null")
ALLOW_FILE_ORIGIN=true

# Requests per minute per IP. The frontend should debounce typing (~300ms).
VALIDATE_RATE_LIMIT_PER_MIN=120
START_RATE_LIMIT_PER_MIN=30

GAME_TTL_MINUTES=240
MAX_VALIDATIONS_PER_GAME=5000

# Timezone used for "today's date" rules and the daily seed
DEFAULT_TZ=Asia/Kolkata
LOG_REQUESTS=true
